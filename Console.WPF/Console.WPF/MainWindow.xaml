<Window x:Class="Console.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Console.WPF.Views"
        Title="集成测试控制台" Height="760" Width="1160" Icon="app.ico"
        Background="{DynamicResource AppBg}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8">
            <TextBlock Text="集成测试控制台" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border x:Name="StatusPill" CornerRadius="12" BorderThickness="1" Margin="14,0,0,0"
                    Padding="10,3" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBg}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{DynamicResource SubtleFg}"/>
                    <TextBlock x:Name="EnvInfo" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Text="自检中..."/>
                </StackPanel>
            </Border>
            <TextBlock Text="Python:" VerticalAlignment="Center" Margin="16,0,4,0" FontSize="12"
                       Foreground="{DynamicResource SubtleFg}"/>
            <TextBox x:Name="PythonBox" Width="110" VerticalAlignment="Center" TextChanged="PythonChanged"/>
            <Button Content="自动检测" Margin="4,0" Click="DetectPython"/>
            <CheckBox x:Name="DemoCheck" Content="Demo(无硬件)" IsChecked="True"
                      VerticalAlignment="Center" Margin="8,0" Checked="DemoToggled" Unchecked="DemoToggled"/>
            <Button Content="Python自检" Margin="8,0" Click="SelfCheck"/>
        </StackPanel>
        <TabControl x:Name="Tabs" Margin="10,0,10,10" SelectionChanged="TabChanged">
            <TabItem Header="1.测试系统"><v:SystemView x:Name="SystemTab"/></TabItem>
            <TabItem Header="2.测试运行"><v:RunWorkspaceView x:Name="RunWorkspace"/></TabItem>
            <TabItem Header="设置"><v:SettingsView x:Name="SettingsTab"/></TabItem>
            <TabItem Header="帮助"><v:HelpView x:Name="HelpTab"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
