<UserControl x:Class="Console.WPF.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Margin="8">
        <StackPanel MaxWidth="700">
            <TextBlock Text="快速上手" FontWeight="Bold" FontSize="14" Margin="0,4"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Text="1. 测试项目：选中一个项目；外部项目包点“安装项目包(.itcpkg)”导入。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Text="2. 系统框图+仪器：点“扫描仪器”，点击仪器节点绑定 VISA 地址（★为推荐；无硬件勾选顶部 Demo）。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Text="3. 测试配置：按表单调参，可存文件复用；同一配置可用于多轮测量。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Text="4. 运行监控：填轮标签（如 DUT_1,DUT_2），开始运行；支持暂停 / 继续 / 确认下一步 / 终止。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Text="5. 历史结果：打开 results/… 查看 raw.csv / xlsx / png。"/>
            <TextBlock Text="常见问题" FontWeight="Bold" FontSize="14" Margin="0,16,0,0"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource SubtleFg}" Text="顶部红字“找不到引擎”：确认 engine 文件夹与 exe 同级。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource SubtleFg}" Text="“引擎调用失败 exit=9009”：Python 命令改成 python 或点“自动检测”。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource SubtleFg}" Text="“引擎通但缺依赖”：执行 py -3 -m pip install -r engine\requirements.txt。"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4" Foreground="{DynamicResource SubtleFg}" Text="仪器扫描为空：先装 VISA 及仪器 USB 驱动，或勾 Demo 模式验证流程。"/>
            <StackPanel Orientation="Horizontal" Margin="0,12">
                <Button Content="在浏览器中打开完整帮助" Style="{StaticResource PrimaryButton}" Click="OpenFullHelp"/>
                <TextBlock x:Name="PathText" Margin="12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleFg}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
