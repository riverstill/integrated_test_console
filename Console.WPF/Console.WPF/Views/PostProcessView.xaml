<UserControl x:Class="Console.WPF.Views.PostProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="后处理" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="本轮轮次" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="RoundList" MaxHeight="140"/>
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <Button Content="导出曲线PNG" Padding="10,2" Click="ExportPng"/>
                    <Button Content="打开报告目录" Padding="10,2" Margin="6,0" Click="OpenReport"/>
                </StackPanel>
                <TextBlock Text="历史会话" FontWeight="Bold" Margin="0,10,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="刷新" Padding="10,2" Click="RefreshHistory"/>
                </StackPanel>
                <ListBox x:Name="HistoryList" MaxHeight="220" MouseDoubleClick="OpenHistory">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="4"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Foreground="{DynamicResource SubtleFg}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,6" Text="双击历史会话打开目录。报告文件（raw.csv/xlsx/png）由引擎生成。"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
