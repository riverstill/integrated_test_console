<UserControl x:Class="Console.WPF.Views.ProjectSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="项目选择" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="刷新" Padding="10,2" Click="Refresh"/>
            <Button Content="安装包" Padding="10,2" Margin="6,0" Click="InstallPkg"/>
            <Button Content="导出包" Padding="10,2" Click="ExportPkg"/>
        </StackPanel>
        <ListBox x:Name="List" SelectionChanged="Selected">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SubtleFg}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Id}" Foreground="{DynamicResource SubtleFg}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
