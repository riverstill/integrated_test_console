<UserControl x:Class="Console.WPF.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="RootBox" Width="420" Text="results"/>
            <Button Content="刷新" Padding="12,4" Margin="8,0" Click="Refresh"/>
            <Button Content="打开目录" Padding="12,4" Click="Open"/>
        </StackPanel>
        <ListBox x:Name="List" MouseDoubleClick="Open">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="4"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
