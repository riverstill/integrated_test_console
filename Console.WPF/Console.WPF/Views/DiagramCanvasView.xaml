<UserControl x:Class="Console.WPF.Views.DiagramCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="框图预览（点击仪器节点绑定）" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="Canvas" Height="420" Width="640" Background="#0B1220"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
