<UserControl x:Class="Console.WPF.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="加载项目默认" Padding="12,4" Click="LoadDefault"/>
            <Button Content="从文件加载" Padding="12,4" Margin="8,0" Click="LoadFile"/>
            <Button Content="存为文件" Padding="12,4" Click="SaveFile"/>
            <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleFg}"
                       Text="同一配置可应用到多轮 DUT 测量"/>
        </StackPanel>
        <ScrollViewer><StackPanel x:Name="Form"/></ScrollViewer>
    </DockPanel>
</UserControl>
