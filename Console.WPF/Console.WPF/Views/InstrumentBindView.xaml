<UserControl x:Class="Console.WPF.Views.InstrumentBindView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="连接仪器" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <Button DockPanel.Dock="Top" Content="扫描仪器" Padding="12,4" Margin="0,0,0,6"
                HorizontalAlignment="Left" Click="Scan"/>
        <ScrollViewer>
            <StackPanel>
                <TextBlock Text="已扫描仪器" FontWeight="Bold" Margin="0,0,0,4"/>
                <ListBox x:Name="ScanList" MaxHeight="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Visa}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Idn}" Foreground="{DynamicResource SubtleFg}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="绑定状态" FontWeight="Bold" Margin="0,10,0,4"/>
                <StackPanel x:Name="StatusPanel"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
