<UserControl x:Class="Console.WPF.Views.RunCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot;assembly=ScottPlot.WPF">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="绘图区" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="开始运行" Style="{StaticResource PrimaryButton}" Click="Start"/>
            <Button Content="暂停" Margin="8,0" Click="Pause"/>
            <Button Content="继续" Click="Resume"/>
            <Button Content="确认下一步" Margin="8,0" Click="Confirm"/>
            <Button Content="终止" Style="{StaticResource DangerButton}" Click="Stop"/>
            <TextBlock x:Name="Status" Margin="12,0" VerticalAlignment="Center" Text="就绪"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="轮标签:" VerticalAlignment="Center"/>
            <TextBox x:Name="LabelsBox" Width="220" Margin="6,0" Text="DUT_1,DUT_2"/>
            <TextBlock Text="输出:" VerticalAlignment="Center" Margin="6,0"/>
            <TextBox x:Name="OutBox" Width="220" Text="results/session1"/>
        </StackPanel>
        <sp:WpfPlot x:Name="Plot" MinHeight="240"/>
        <Expander Header="实时数据表" Margin="0,6,0,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="180"/>
        </Expander>
        <TextBox x:Name="LogBox" Height="110" Margin="0,6,0,0"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </DockPanel>
</UserControl>
